"""Execute the 14 checks specified in dq_checks_catalog and retain evidence."""
from __future__ import annotations
from datetime import datetime, timezone
from pathlib import Path
import json
import pandas as pd
import duckdb

ROOT = Path(__file__).resolve().parents[1]
DB_FILE = ROOT / "data" / "pulseiq.duckdb"
REPORTS = ROOT / "reports"

CHECKS = [
    ("DQ-C01", "Payroll equals ledger", "Critical", "Monthly payroll employer cost should reconcile to ledger accounts 5001-5005 within INR 0.01.", "Review the affected posting period and payroll/ledger source rows.", """
      WITH p AS (
          SELECT strftime(CAST(period_end_date AS DATE), '%Y-%m') AS period_month,
                 SUM(employer_cost) AS payroll_cost
          FROM warehouse.fact_payroll
          GROUP BY 1
      ),
      l AS (
          SELECT posting_period AS period_month,
                 SUM(signed_amount_debit_positive) AS ledger_expense
          FROM warehouse.fact_ledger
          WHERE TRY_CAST(account_code AS INTEGER) BETWEEN 5001 AND 5005
          GROUP BY 1
      )
      SELECT COUNT(*)
      FROM p JOIN l USING (period_month)
      WHERE ABS(p.payroll_cost - l.ledger_expense) > 0.01"""),
    ("DQ-C02", "Ledger balanced", "Critical", "Each journal entry must have equal total debits and credits within INR 0.005.", "Reject the unbalanced entry and alert the ledger owner.", "SELECT COUNT(*) FROM (SELECT entry_id FROM warehouse.fact_ledger GROUP BY entry_id HAVING ABS(SUM(debit)-SUM(credit))>0.005) x"),
    ("DQ-C03", "Unique payroll rows", "Critical", "One payroll row per employee per run.", "Trace and remove the duplicate payroll row after source review.", "SELECT COALESCE(SUM(n-1),0) FROM (SELECT employee_id,run_id,COUNT(*) n FROM warehouse.fact_payroll GROUP BY 1,2 HAVING COUNT(*)>1) x"),
    ("DQ-C04", "No orphan employees", "Critical", "Every payroll employee_id must exist in dim_employee.", "Fix the key or load the missing employee record.", "SELECT COUNT(*) FROM warehouse.fact_payroll p WHERE NOT EXISTS (SELECT 1 FROM warehouse.dim_employee d WHERE d.employee_id=p.employee_id)"),
    ("DQ-C05", "No attendance after exit", "Warning", "Attendance month should not fall after the employee exit month.", "Ask HR to confirm the exit date and attendance entry.", "SELECT COUNT(*) FROM warehouse.fact_attendance_monthly a JOIN warehouse.dim_employee d ON a.employee_id=d.employee_id AND d.is_current='Y' WHERE d.exit_date IS NOT NULL AND CAST(a.period_end_date AS DATE)>CAST(last_day(d.exit_date) AS DATE)"),
    ("DQ-C06", "Unpaid leave deducted", "Warning", "Unpaid absence days in attendance should be reflected in payroll LOP days for the same employee-month (0.5-day tolerance).", "Review unpaid-leave mapping and the payroll deduction run.", """
      WITH a AS (
          SELECT employee_id,
                 strftime(CAST(period_end_date AS DATE), '%Y-%m') AS period_month,
                 SUM(unpaid_absence_days) AS unpaid_days
          FROM warehouse.fact_attendance_monthly
          GROUP BY 1, 2
      ),
      p AS (
          SELECT employee_id,
                 strftime(CAST(period_end_date AS DATE), '%Y-%m') AS period_month,
                 SUM(lop_days) AS lop_days
          FROM warehouse.fact_payroll
          GROUP BY 1, 2
      )
      SELECT COUNT(*)
      FROM a LEFT JOIN p USING (employee_id, period_month)
      WHERE a.unpaid_days > 0.5
        AND COALESCE(p.lop_days, 0) < a.unpaid_days - 0.5"""),
    ("DQ-C07", "Invoice arithmetic", "Warning", "Invoice paid amount must not exceed total and balance due must not be negative.", "Correct the invoice payment or total using the supporting receipt.", "SELECT COUNT(*) FROM warehouse.fact_invoice WHERE amount_paid>total_amount OR balance_due<0"),
    ("DQ-C08", "Expense arithmetic", "Warning", "Total expense should equal amount excluding GST plus GST within INR 0.01.", "Correct the vendor bill arithmetic using the source invoice.", "SELECT COUNT(*) FROM warehouse.fact_expense WHERE ABS(total_amount-(amount_excl_gst+gst_amount))>0.01"),
    ("DQ-C09", "Task dates sensible", "Warning", "Completion cannot be before start, and Done tasks require a completion date.", "Ask the team to repair the task board dates/status.", "SELECT COUNT(*) FROM warehouse.fact_task WHERE completed_date<started_date OR (status='Done' AND completed_date IS NULL) OR (started_date IS NOT NULL AND created_date>started_date)"),
    ("DQ-C10", "Leave dates sensible", "Warning", "Leave end date must be on or after start date.", "Verify the original leave request and date keys; do not auto-swap dates.", "SELECT COUNT(*) FROM warehouse.fact_leave WHERE end_date<start_date"),
    ("DQ-C11", "AI feeds are fresh", "Warning", "Attrition risk predictions should be within seven days of the newest batch in this static dataset.", "Ask the AI team to refresh stale predictions and record the model batch.", "SELECT COUNT(*) FROM warehouse.fact_attrition_risk WHERE CAST(as_of_date AS DATE)<(SELECT MAX(CAST(as_of_date AS DATE)) FROM warehouse.fact_attrition_risk)-INTERVAL 7 DAY"),
    ("DQ-C12", "Dimension history does not overlap", "Critical", "Employee effective-date intervals must not overlap across versions.", "Close the previous version before the next version's valid_from.", """
      SELECT COUNT(*) FROM warehouse.dim_employee a JOIN warehouse.dim_employee b
      ON a.employee_id=b.employee_id AND a.employee_key<b.employee_key
      AND COALESCE(CAST(a.valid_to AS DATE), DATE '9999-12-31')>=CAST(b.valid_from AS DATE)
      AND COALESCE(CAST(b.valid_to AS DATE), DATE '9999-12-31')>=CAST(a.valid_from AS DATE)"""),
    ("DQ-C13", "Pipeline freshness", "Critical", "The latest successful pipeline run should be no more than 24 hours old.", "Check scheduler status, source availability, and the latest run log.", "SELECT CASE WHEN MAX(finished_at)>=current_timestamp-INTERVAL 24 HOUR THEN 0 ELSE 1 END FROM audit.etl_run_log WHERE status='SUCCESS'"),
    ("DQ-C14", "Minimum group size", "Critical", "Metric values and sensitive supporting aggregates must be suppressed below the applicable minimum group size.", "Suppress the cell or roll up to a larger group before display.", """
      SELECT
        (SELECT COUNT(*) FROM analytics.vw_all_metrics WHERE metric_value IS NOT NULL AND min_group_size IS NOT NULL AND (group_size IS NULL OR group_size<min_group_size))
        + (SELECT COUNT(*) FROM analytics.vw_workforce_mix WHERE (group_size IS NULL OR group_size<5) AND employee_count IS NOT NULL)
        + (SELECT COUNT(*) FROM analytics.vw_location_summary WHERE (group_size IS NULL OR group_size<5) AND employee_count IS NOT NULL)
        + (SELECT COUNT(*) FROM analytics.vw_leave_type_summary WHERE (group_size IS NULL OR group_size<5) AND (request_count IS NOT NULL OR visible_request_count IS NOT NULL))
        + (SELECT COUNT(*) FROM analytics.vw_budget_vs_actual WHERE (group_size IS NULL OR group_size<5) AND (actual_cost IS NOT NULL OR budget_cost IS NOT NULL OR variance IS NOT NULL OR variance_pct IS NOT NULL OR visible_actual_cost IS NOT NULL))
        + (SELECT COUNT(*) FROM analytics.vw_attrition_risk_department WHERE (group_size IS NULL OR group_size<10) AND (employee_count IS NOT NULL OR high_risk_count IS NOT NULL OR high_risk_share_pct IS NOT NULL))
        + (SELECT COUNT(*) FROM analytics.vw_task_summary WHERE (group_size IS NULL OR group_size<5) AND (planned_tasks IS NOT NULL OR done_tasks IS NOT NULL OR blocked_tasks IS NOT NULL OR completed_points IS NOT NULL OR avg_cycle_days IS NOT NULL OR completion_rate_pct IS NOT NULL OR on_time_rate_pct IS NOT NULL))
    """),
]


def run_checks() -> pd.DataFrame:
    REPORTS.mkdir(exist_ok=True)
    con = duckdb.connect(str(DB_FILE))
    try:
        con.execute("CREATE SCHEMA IF NOT EXISTS audit")
        results = []
        run_at = datetime.now(timezone.utc)
        for cid, name, severity, description, action, sql in CHECKS:
            try:
                count = int(con.execute(sql).fetchone()[0] or 0)
                error = ""
            except Exception as exc:
                count = -1
                error = f"Check query error: {type(exc).__name__}: {exc}"
            if count < 0:
                status = "ERROR"
            elif count == 0:
                status = "PASS"
            elif severity.lower() == "critical":
                status = "FAIL"
            else:
                status = "WARN"
            results.append({"run_at_utc": run_at.isoformat(), "check_id": cid, "check_name": name, "severity": severity, "rows_affected": count, "status": status, "description": description, "recommended_action": action, "error": error})
        frame = pd.DataFrame(results)
        con.register("_dq_frame", frame)
        try:
            con.execute("CREATE TABLE IF NOT EXISTS audit.dq_results (run_at_utc VARCHAR, check_id VARCHAR, check_name VARCHAR, severity VARCHAR, rows_affected BIGINT, status VARCHAR, description VARCHAR, recommended_action VARCHAR, error VARCHAR)")
            con.execute("DELETE FROM audit.dq_results")
            con.execute("INSERT INTO audit.dq_results SELECT * FROM _dq_frame")
        finally:
            con.unregister("_dq_frame")
        frame.to_csv(REPORTS / "dq_results.csv", index=False)
        lines = ["# Data quality report", "", f"Run time (UTC): {run_at.isoformat()}", "", "| Check | Severity | Status | Rows affected |", "|---|---|---:|---:|"]
        for r in results:
            lines.append(f"| {r['check_id']} — {r['check_name']} | {r['severity']} | **{r['status']}** | {r['rows_affected']} |")
        lines += ["", "## Interpretation", "", "A FAIL on a Critical check should block promotion of affected data into a production release. WARN means the check found a quality issue that should be reviewed. The supplied workbook intentionally contains known issues; failures are evidence that the gatekeeper detects them, not proof the source is production-clean.", "", "## Recommended handling", "", "Raw tables remain unchanged for auditability. The analytics layer excludes selected invalid records from the affected metric calculations; it does not overwrite or silently repair the raw source."]
        (REPORTS / "dq_report.md").write_text("\n".join(lines), encoding="utf-8")
        _write_known_issue_review(con, frame)
        return frame
    finally:
        con.close()


def _write_known_issue_review(con: duckdb.DuckDBPyConnection, result: pd.DataFrame) -> None:
    try:
        issues = con.execute("SELECT * FROM warehouse.dq_known_issues").df()
    except Exception:
        return
    mapping = {
        "No attendance after employee exit": "DQ-C05",
        "No attendance after employee exit_date": "DQ-C05",
        "Unique (employee_id, run_id)": "DQ-C03",
        "Every fact employee_id exists in dim_employee": "DQ-C04",
        "Monthly payroll employer cost = ledger salary-related expense (tolerance 0.01)": "DQ-C01",
        "balance_due >= 0 and amount_paid <= total_amount": "DQ-C07",
        "completed_date >= started_date": "DQ-C09",
        "status = 'Done' implies completed_date is not null": "DQ-C09",
        "end_date >= start_date": "DQ-C10",
        "as_of_date within 7 days of the latest as_of_date": "DQ-C11",
        "total_amount = amount_excl_gst + gst_amount": "DQ-C08",
        "No overlap between valid_from/valid_to for the same employee": "DQ-C12",
    }
    lookup = result.set_index("check_id").to_dict("index")
    rows = []
    for _, issue in issues.iterrows():
        expected_rule = str(issue.get("check_that_should_catch_it", ""))
        check_id = mapping.get(expected_rule, "")
        r = lookup.get(check_id, {})
        ids = str(issue.get("affected_record_ids", ""))
        # A check with non-zero affected rows shows the rule fired. IDs are listed for reviewer follow-up.
        rows.append({"issue_id": issue.get("issue_id"), "table_name": issue.get("table_name"), "issue_type": issue.get("issue_type"), "expected_check_id": check_id, "expected_check": expected_rule, "check_status": r.get("status", "NOT MAPPED"), "check_rows_affected": r.get("rows_affected", None), "check_fired": bool(r and r.get("rows_affected", 0) > 0), "affected_record_ids": ids, "effect_on_totals": issue.get("effect_on_totals", "")})
    pd.DataFrame(rows).to_csv(REPORTS / "known_issue_review.csv", index=False)


def main() -> None:
    frame = run_checks()
    print("\nData quality gatekeeper")
    print(frame[["check_id", "check_name", "status", "rows_affected"]].to_string(index=False))
    print(f"\nReports: {REPORTS / 'dq_results.csv'} and {REPORTS / 'dq_report.md'}")


if __name__ == "__main__":
    main()
