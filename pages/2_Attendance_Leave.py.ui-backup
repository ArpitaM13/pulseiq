import streamlit as st
import pandas as pd
import plotly.express as px
from src.dashboard_utils import metric, load_view, apply_period_filter, department_filter, privacy_note

st.title("Attendance & Leave")
st.caption("Phase 2 · Task 6 — Attendance rate, punctuality and leave patterns")
a=metric("M13")
if a.empty: st.info("Run the pipeline first."); st.stop()
a=apply_period_filter(a); a=department_filter(a)
a=a.copy(); a["attendance_pct"]=a["metric_value"]*100
x=a.dropna(subset=["attendance_pct"])
if not x.empty:
    fig=px.line(x,x="period",y="attendance_pct",color="department_id",markers=True,title="Attendance rate by department",labels={"period":"Month","attendance_pct":"Attendance (%)"})
    st.plotly_chart(fig,use_container_width=True)
    st.caption(f"Visible department-month points: {len(x):,}. Paid leave is treated as not present under the supplied metric definition.")
l=metric("M14").copy()
if not l.empty:
    l=apply_period_filter(l); l=department_filter(l)
    l["late_per_present_day"]=l["metric_value"]
    shown=l.dropna(subset=["late_per_present_day"])
    if not shown.empty:
        fig=px.line(shown,x="period",y="late_per_present_day",color="department_id",markers=True,title="Late arrivals per present day",labels={"period":"Month","late_per_present_day":"Late arrival ratio"})
        st.plotly_chart(fig,use_container_width=True)
leave=load_view("vw_leave_type_summary")
if not leave.empty:
    st.subheader("Leave requests by type and status")
    leave=leave.dropna(subset=["visible_request_count"])
    if not leave.empty:
        fig=px.bar(leave,x="leave_type_code",y="visible_request_count",color="status",barmode="group",title="Only leave groups meeting minimum size are shown",labels={"visible_request_count":"Requests","leave_type_code":"Leave type"})
        st.plotly_chart(fig,use_container_width=True)
    st.caption("Two swapped-date requests are quarantined; they are not silently rewritten.")
privacy_note()
